# Native Linux/x86-64 core-foundation evidence image.
#
# Build this only through scripts/dev-x86_64.sh. The launcher requires a
# native Linux/x86-64 host and always requests linux/amd64, so this image must
# never become an emulated substitute for the AArch64 development image.
# The Linux 5.10 UAPI source and derived x86 export identity are mirrored in
# compat/upstreams.toml, because Docker cannot consume that TOML pin directly.
FROM alpine:3.24.1@sha256:79ff19e9084a00eece421b2523fb93e22d730e2c0e525905de047e848e56d95f

ARG RUST_TOOLCHAIN=nightly-2026-07-24
ARG RUST_TARGET=x86_64-unknown-linux-musl
ARG MUSL_VERSION=1.2.6
ARG MUSL_SHA256=d585fd3b613c66151fc3249e8ed44f77020cb5e6c1e635a616d3f9f82460512a
ARG MUSL_REV=9fa28ece75d8a2191de7c5bb53bed224c5947417
ARG MUSL_MIRROR=https://github.com/ifduyue/musl.git
ARG LINUX_UAPI_VERSION=5.10
ARG LINUX_UAPI_SHA256=dcdf99e43e98330d925016985bfbc7b83c66d367b714b2de0cbbfcbf83d8ca43
# These pin the deterministic `make headers_install` output as well as its
# upstream source archive.  The runtime verifier repeats both checks, so an
# image cannot merely validate a manifest it generated during the same build.
ARG LINUX_UAPI_HEADER_COUNT=935
ARG LINUX_UAPI_HEADER_MANIFEST_SHA256=00cdc98ceb35926f68dc57dc0d84a989a6df4f60f84b1ae5981b54bb1088eb0e

ENV RUSTUP_HOME=/opt/rustup \
    CARGO_HOME=/opt/cargo \
    PATH=/opt/cargo/bin:/opt/musl-1.2.6/bin:${PATH}

# Keep the image limited to the target-specific `crabc-core` lib suite, the
# bounded direct `crabc-rs` subset, one isolated raw C-ABI syscall probe, and
# source-only x86 relocation tests. Its pinned musl tree is an oracle-only
# input: it cannot select a crabc libc artifact, runtime, sysroot, or allocator
# profile.
RUN test "$(uname -m)" = "x86_64" \
    && apk add --no-cache \
        bash \
        binutils \
        build-base \
        clang \
        ca-certificates \
        coreutils \
        curl \
        git \
        python3 \
        rsync \
        rustup \
        tar \
        xz \
    # Alpine packages the bootstrap binary as rustup-init rather than rustup.
    && rustup-init -y --profile minimal --default-toolchain "${RUST_TOOLCHAIN}" \
    && rustup target add "${RUST_TARGET}" \
    # Match rust-toolchain.toml so Cargo never mutates an ephemeral test
    # container while resolving the workspace toolchain declaration.
    && rustup component add rust-src llvm-tools

# Alpine's bootstrap musl is never the C/POSIX oracle. Build only the pinned
# upstream source under /opt, so the oracle compiler has an unambiguous header,
# library, and dynamic-loader root. The release archive is primary and its
# SHA-256 is checked before extraction. A documented immutable v1.2.6 commit
# is the sole network fallback, and is checked after checkout.
RUN set -eu \
    && if curl --fail --location --retry 3 --output /tmp/musl.tar.gz \
            "https://musl.libc.org/releases/musl-${MUSL_VERSION}.tar.gz"; then \
        echo "${MUSL_SHA256}  /tmp/musl.tar.gz" | sha256sum -c - \
        && tar -C /tmp -xzf /tmp/musl.tar.gz; \
    else \
        rm -f /tmp/musl.tar.gz \
        && git clone --depth 1 --branch "v${MUSL_VERSION}" "${MUSL_MIRROR}" \
            "/tmp/musl-${MUSL_VERSION}" \
        && cd "/tmp/musl-${MUSL_VERSION}" \
        && test "$(git rev-parse HEAD)" = "${MUSL_REV}" \
        && rm -rf .git; \
    fi \
    && cd "/tmp/musl-${MUSL_VERSION}" \
    && ./configure \
        --prefix="/opt/musl-${MUSL_VERSION}" \
        --syslibdir="/opt/musl-${MUSL_VERSION}/lib" \
    && make -s -j"$(getconf _NPROCESSORS_ONLN)" \
    && make -s install \
    && sh tools/musl-gcc.specs.sh \
        "/opt/musl-${MUSL_VERSION}/include" \
        "/opt/musl-${MUSL_VERSION}/lib" \
        "/opt/musl-${MUSL_VERSION}/lib/ld-musl-x86_64.so.1" \
        > "/opt/musl-${MUSL_VERSION}/lib/musl-gcc.specs" \
    && test -f "/opt/musl-${MUSL_VERSION}/lib/libc.so" \
    && test -f "/opt/musl-${MUSL_VERSION}/lib/ld-musl-x86_64.so.1" \
    && test "$(readlink -f "/opt/musl-${MUSL_VERSION}/lib/ld-musl-x86_64.so.1")" = \
        "/opt/musl-${MUSL_VERSION}/lib/libc.so" \
    # Alpine's GCC specs need this support archive even when the selected
    # runtime is the pinned musl tree. Keeping it beneath /opt preserves the
    # reference tree's library priority over the bootstrap system libc.
    && cp /usr/lib/libssp_nonshared.a "/opt/musl-${MUSL_VERSION}/lib/" \
    && printf '%s\n' \
        'format=crabc-pinned-musl-oracle-v1' \
        "version=${MUSL_VERSION}" \
        "source_sha256=${MUSL_SHA256}" \
        "fallback_revision=${MUSL_REV}" \
        'architecture=x86_64' \
        > "/opt/musl-${MUSL_VERSION}/.crabc-oracle" \
    && sha256sum "/opt/musl-${MUSL_VERSION}/lib/musl-gcc.specs" \
        > "/opt/musl-${MUSL_VERSION}/.crabc-musl-gcc-specs.sha256" \
    && rm -rf /tmp/musl.tar.gz "/tmp/musl-${MUSL_VERSION}"

COPY docker/x86_64-musl-oracle-gcc /usr/local/bin/crabc-x86_64-musl-gcc
RUN chmod 0755 /usr/local/bin/crabc-x86_64-musl-gcc

# Public libc headers that include Linux UAPI declarations need a declared
# target input.  Do not borrow Alpine's ambient /usr/include tree: export the
# exact Linux 5.10 x86 UAPI tree into its own hashed prefix and let header
# evidence name that prefix explicitly.  This is a kernel-header input only;
# it neither supplies a libc implementation nor changes the pinned musl
# oracle.
#
# kernel.org's large release archives occasionally reset an HTTP/2 stream in
# container builders. Resume the same checksum-pinned object over HTTP/1.1
# rather than falling back to an ambient distro package.
RUN set -eu \
    && linux_uapi_root="/opt/linux-${LINUX_UAPI_VERSION}-uapi" \
    && curl --fail --location --http1.1 --continue-at - --retry 5 \
        --retry-all-errors --retry-delay 2 --output /tmp/linux-uapi.tar.xz \
        "https://cdn.kernel.org/pub/linux/kernel/v5.x/linux-${LINUX_UAPI_VERSION}.tar.xz" \
    && echo "${LINUX_UAPI_SHA256}  /tmp/linux-uapi.tar.xz" | sha256sum -c - \
    && tar -C /tmp -xJf /tmp/linux-uapi.tar.xz \
    && make -C "/tmp/linux-${LINUX_UAPI_VERSION}" ARCH=x86 headers_install \
        INSTALL_HDR_PATH="${linux_uapi_root}" \
    && test -f "${linux_uapi_root}/include/linux/kd.h" \
    && test -f "${linux_uapi_root}/include/linux/soundcard.h" \
    && test -f "${linux_uapi_root}/include/linux/vt.h" \
    && (cd "${linux_uapi_root}/include" \
        && find . -type f -print0 | LC_ALL=C sort -z | xargs -0 sha256sum) \
        > "${linux_uapi_root}/.crabc-linux-uapi.headers.sha256" \
    && rm -rf /tmp/linux-uapi.tar.xz "/tmp/linux-${LINUX_UAPI_VERSION}"

# Check the fixed derived export identity in a separate ordinary Docker layer.
# This intentionally needs no BuildKit-only cache mount: scripts/dev-x86_64.sh
# builds it with ordinary `docker build`.
RUN set -eu \
    && linux_uapi_root="/opt/linux-${LINUX_UAPI_VERSION}-uapi" \
    && observed_header_count="$(wc -l < "${linux_uapi_root}/.crabc-linux-uapi.headers.sha256" | tr -d '[:space:]')" \
    && test "${observed_header_count}" = "${LINUX_UAPI_HEADER_COUNT}" \
    && echo "${LINUX_UAPI_HEADER_MANIFEST_SHA256}  ${linux_uapi_root}/.crabc-linux-uapi.headers.sha256" | sha256sum -c - \
    && printf '%s\n' \
        'format=crabc-linux-uapi-v1' \
        "version=${LINUX_UAPI_VERSION}" \
        "source_sha256=${LINUX_UAPI_SHA256}" \
        'architecture=x86_64' \
        'install_arch=x86' \
        "header_count=${LINUX_UAPI_HEADER_COUNT}" \
        "header_manifest_sha256=${LINUX_UAPI_HEADER_MANIFEST_SHA256}" \
        > "${linux_uapi_root}/.crabc-linux-uapi"

WORKDIR /workspace
CMD ["bash"]
