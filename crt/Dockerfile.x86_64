# Native Linux/x86-64 evidence image for the bounded CRT static-PIE slice.
#
# This is intentionally not a project-wide x86 development image and carries
# no crabc sysroot, libc, loader, or facade build surface.
FROM alpine:3.24.1@sha256:79ff19e9084a00eece421b2523fb93e22d730e2c0e525905de047e848e56d95f

ARG RUST_TOOLCHAIN=nightly-2026-07-24

ENV RUSTUP_HOME=/opt/rustup \
    CARGO_HOME=/opt/cargo \
    PATH=/opt/cargo/bin:${PATH}

RUN test "$(uname -m)" = "x86_64"

RUN apk add --no-cache \
        binutils \
        ca-certificates \
        lld \
        llvm \
        python3 \
        rustup \
    && rustup-init -y --profile minimal --default-toolchain "${RUST_TOOLCHAIN}" \
    && rustup component add rust-src llvm-tools \
    && rustup target add x86_64-unknown-linux-musl

WORKDIR /workspace
CMD ["bash"]
