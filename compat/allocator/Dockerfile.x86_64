# Private native Linux/x86-64 image for fixed-mimalloc evidence only.
#
# The private allocator launcher is the sole supported entry point. This image
# deliberately contains no crabc runtime/sysroot tooling and is not a second
# project platform image. It supplies only the pinned C oracle, Rust toolchain,
# and inspection tools used by the private allocator evidence commands.
FROM alpine:3.24.1@sha256:79ff19e9084a00eece421b2523fb93e22d730e2c0e525905de047e848e56d95f

COPY rust-toolchain.toml /tmp/rust-toolchain.toml

ENV RUSTUP_HOME=/opt/rustup \
    CARGO_HOME=/opt/cargo \
    RUSTC_WRAPPER=/usr/local/bin/kache \
    KACHE_CONFIG=/dev/null \
    KACHE_HOST_CONFIG="" \
    KACHE_LOCAL_ONLY=1 \
    KACHE_CACHE_DIR=/workspace/.work/x86_64/kache \
    KACHE_AUTO_CLEAN_ORPHANED_TARGETS=0 \
    KACHE_AUTO_CLEAN_UNUSED_UNITS_DAYS=0 \
    KACHE_AUTO_SHARE_TARGET_FILES=0 \
    KACHE_SEED_NEW_TARGETS=0 \
    CARGO_TARGET_X86_64_UNKNOWN_LINUX_MUSL_LINKER=/usr/local/bin/crabc-x86_64-mold-gcc \
    PATH=/opt/cargo/bin:/opt/musl-1.2.6/bin:${PATH}

# The launcher independently rejects a foreign host. This build-time check
# prevents Docker from silently creating the evidence image under a foreign
# guest architecture.
RUN test "$(uname -m)" = "x86_64"

RUN apk add --no-cache \
        bash \
        binutils \
        build-base \
        ca-certificates \
        clang \
        cmake \
        coreutils \
        curl \
        file \
        git \
        lld \
        linux-headers \
        llvm \
        patch \
        python3 \
        mold \
        rustup \
        tar \
        xz \
    && RUST_TOOLCHAIN="$(sed -n 's/^channel = "\(.*\)"$/\1/p' /tmp/rust-toolchain.toml)" \
    && test -n "${RUST_TOOLCHAIN}" \
    && rustup-init -y --profile minimal --default-toolchain "${RUST_TOOLCHAIN}" \
    && rustup component add rust-src llvm-tools miri

# `miri` is a component of the same pinned nightly; allocator ownership tests run
# its local-engine tests under strict-provenance Miri. It is never a build
# input for allocator or runtime artifacts.

COPY compat/upstreams.toml /tmp/upstreams.toml
COPY docker/install-native-build-tools.py /tmp/install-native-build-tools.py
COPY docker/x86_64-mold-gcc /usr/local/bin/crabc-x86_64-mold-gcc
RUN python3 -B /tmp/install-native-build-tools.py \
    && chmod 0755 /usr/local/bin/crabc-x86_64-mold-gcc
COPY compat/x86_64/musl_oracle.py /tmp/musl_oracle.py
RUN set -eu \
    && MUSL_VERSION="$(python3 -B /tmp/musl_oracle.py --pins /tmp/upstreams.toml version)" \
    && python3 -B /tmp/musl_oracle.py --pins /tmp/upstreams.toml acquire "/tmp/musl-${MUSL_VERSION}" \
    && cd "/tmp/musl-${MUSL_VERSION}" \
    && CC=/usr/local/bin/crabc-x86_64-mold-gcc ./configure \
        --prefix="/opt/musl-${MUSL_VERSION}" \
        --syslibdir="/opt/musl-${MUSL_VERSION}/lib" \
    && make -s -j"$(getconf _NPROCESSORS_ONLN)" \
    && make -s install \
    && sh tools/musl-gcc.specs.sh \
        "/opt/musl-${MUSL_VERSION}/include" \
        "/opt/musl-${MUSL_VERSION}/lib" \
        "/opt/musl-${MUSL_VERSION}/lib/ld-musl-x86_64.so.1" \
        > "/opt/musl-${MUSL_VERSION}/lib/musl-gcc.specs" \
    && test "$(readlink -f "/opt/musl-${MUSL_VERSION}/lib/ld-musl-x86_64.so.1")" = \
        "/opt/musl-${MUSL_VERSION}/lib/libc.so" \
    && cp .crabc-oracle "/opt/musl-${MUSL_VERSION}/.crabc-oracle" \
    && cp /usr/lib/libssp_nonshared.a "/opt/musl-${MUSL_VERSION}/lib/" \
    && rm -rf /tmp/musl.tar.gz "/tmp/musl-${MUSL_VERSION}"

COPY docker/x86_64-musl-oracle-gcc /usr/local/bin/musl-gcc
RUN chmod 0755 /usr/local/bin/musl-gcc

# Check the actual native compiler boundary while the source-authenticated
# oracle is installed. The executable must select that loader and run against
# its libc; the bootstrap Alpine libc is never the comparison oracle.
RUN set -eu \
    && printf '%s\n' '#include <stdio.h>' 'int main(void) { puts("allocator-oracle-ok"); return 0; }' \
        > /tmp/allocator-oracle.c \
    && musl-gcc /tmp/allocator-oracle.c -o /tmp/allocator-oracle \
    && readelf -l /tmp/allocator-oracle | grep -F '/opt/musl-1.2.6/lib/ld-musl-x86_64.so.1' \
    && test "$(/tmp/allocator-oracle)" = allocator-oracle-ok \
    && test "$(rustc -vV | sed -n 's/^host: //p')" = x86_64-unknown-linux-musl \
    && test -f "$(rustc --print target-libdir)/self-contained/libunwind.a" \
    && cmake --version \
    && cargo miri --version \
    && mkdir -p /usr/local/share \
    && sha256sum /usr/local/bin/musl-gcc /opt/musl-1.2.6/lib/musl-gcc.specs \
        /opt/musl-1.2.6/lib/libc.so /usr/bin/gcc /usr/bin/cmake /usr/bin/readelf \
        > /usr/local/share/crabc-allocator-image-tools.sha256 \
    && chmod 0444 /usr/local/share/crabc-allocator-image-tools.sha256 \
    && rm -f /tmp/allocator-oracle.c /tmp/allocator-oracle

WORKDIR /workspace
CMD ["bash"]
