{
  "schema": "crabc-mimalloc-x86_64-engine-performance-matrix",
  "format": 2,
  "boundary": {
    "header": "compat/allocator/perf-x86_64/engine-api.h",
    "fixture": "compat/allocator/perf-x86_64/engine-fixture.c",
    "statement": "One source-shared C fixture calls one opaque, separately compiled backend per lane; the fixture is never compiled with LTO against either backend, so every allocator operation is one ordinary external call in both lanes."
  },
  "lanes": {
    "pinned_c": {
      "backend": "compat/allocator/perf-x86_64/engine-c-backend.c",
      "meaning": "Pinned mimalloc v3.5.0 source in its upstream CMake Release static-library configuration for musl, through its public mi_* operations (the functions its MI_OVERRIDE C ABI selects).",
      "source_configuration_flags": [
        "-O3",
        "-DNDEBUG",
        "-DMI_BUILD_RELEASE",
        "-DMI_CMAKE_BUILD_TYPE=release",
        "-DMI_LIBC_MUSL=1",
        "-DMI_STATIC_LIB",
        "-Wno-unknown-pragmas",
        "-fvisibility=hidden",
        "-fno-builtin-malloc",
        "-ftls-model=initial-exec"
      ],
      "tls_model_note": "Upstream CMake selects local-dynamic for its MI_LIBC_MUSL static library and initial-exec otherwise; both lanes use initial-exec here, and the static non-PIE executable link relaxes either model to local-exec."
    },
    "rust_engine": {
      "backend": "compat/allocator/perf-x86_64/engine-rust-backend.rs",
      "meaning": "crabc-mimalloc persistent per-thread source owners through the hidden __crabc_runtime entry points that crabc-libc's native-mimalloc-shadow selection calls (malloc = native_allocate_aligned(size, 16, false)).",
      "rustc_flags": [
        "-Copt-level=3",
        "-Clto=fat",
        "-Ccodegen-units=1",
        "-Cpanic=abort",
        "-Crelocation-model=static",
        "-Ztls-model=initial-exec"
      ],
      "engine_rustflags": [
        "-Crelocation-model=static",
        "-Ztls-model=initial-exec",
        "-Zembed-metadata=yes"
      ],
      "engine_rustflags_note": "-Zembed-metadata=yes only restores full crate metadata inside each rlib (current Cargo otherwise emits metadata stubs plus separate .rmeta files), so the standalone rustc backend step can consume Cargo's reported rlibs; it does not change code generation."
    }
  },
  "shared_build": {
    "fixture_flags": [
      "-std=c11",
      "-O3",
      "-DNDEBUG",
      "-fno-pie",
      "-fno-builtin",
      "-ffunction-sections",
      "-fdata-sections",
      "-ftls-model=initial-exec"
    ],
    "link_flags": [
      "-static",
      "-no-pie",
      "-pthread",
      "-Wl,--gc-sections"
    ],
    "statement": "Both lanes link one static non-PIE musl 1.2.6 executable, matching the relocation model of crabc's owned-static native-shadow product."
  },
  "modes": {
    "smoke": {
      "samples": 3,
      "warmup_processes": 1,
      "batch_divisor": 4
    },
    "full": {
      "samples": 21,
      "warmup_processes": 2,
      "batch_divisor": 1
    }
  },
  "architecture_rows": {
    "single_thread": "local_scaling_1",
    "four_thread": "local_scaling_4",
    "meaning": "plan.md's early architecture sanity check compares these rows: Rust/C single-thread throughput, and each lane's four-worker aggregate throughput over its own one-worker throughput. The runner reports these indicative development values; it records no verdict."
  },
